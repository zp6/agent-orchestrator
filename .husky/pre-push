#!/usr/bin/env sh
set -e

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-Test}"
export GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-test@example.com}"
export GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-Test}"
export GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-test@example.com}"

echo "[pre-push] tsc --noEmit"
npx tsc --noEmit

echo "[pre-push] npm test"
npm test --silent

echo "[pre-push] OK"
