# claude-orchestrator-reviewer — environment configuration
#
# Copy this file to ~/.claude-orchestrator/.env and fill in the values.
# The reviewer reads these at startup via process.env.
#
# Required for Telegram notifications (escalations, task rejections):
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional: override the path to the shared SQLite state database
# Defaults to ~/.claude-orchestrator/state.db
# STATE_DB_PATH=/path/to/state.db
